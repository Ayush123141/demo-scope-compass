<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <!-- Dark Earthy Circular Background -->
  <rect width="64" height="64" rx="16" fill="#0d1512"/>
  <rect x="1" y="1" width="62" height="62" rx="15" stroke="#10b981" stroke-opacity="0.4" stroke-width="2"/>
  
  <!-- Spaceborne Satellite Orbit Ring (Copernicus Sentinel Radar) -->
  <ellipse cx="32" cy="32" rx="23" ry="9.5" transform="rotate(-28 32 32)" stroke="#06b6d4" stroke-width="2.2" stroke-dasharray="4 2.5" stroke-opacity="0.85"/>
  <!-- Orbiting Satellite Node -->
  <circle cx="50" cy="21.5" r="3.2" fill="#22d3ee"/>
  <circle cx="50" cy="21.5" r="5.5" stroke="#22d3ee" stroke-opacity="0.5" stroke-width="1.5"/>

  <!-- Soil Root Zone Foundation (Mitti) -->
  <ellipse cx="32" cy="48" rx="14" ry="3.5" fill="#059669" fill-opacity="0.45"/>
  
  <!-- Vibrant Agronomic Sprout Leaves -->
  <path d="M32 46 C32 36 21 29 17 31 C16 38 23 45 32 46 Z" fill="#22c55e"/>
  <path d="M32 46 C32 31 43 23 47 25 C49 33 42 43 32 46 Z" fill="#10b981"/>
  <path d="M32 46 V33" stroke="#86efac" stroke-width="2.2" stroke-linecap="round"/>
</svg>
